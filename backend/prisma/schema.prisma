// Mikro - esquema de datos
// Marketplace que conecta pymes con micro-influencers.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x es el motor que necesitan las funciones de Netlify
  // (Amazon Linux 2023); "native" mantiene el desarrollo en local.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexion directa para migraciones: el pooler no admite DDL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cuentas
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String // BRAND | CREATOR | ADMIN
  name          String
  avatarUrl     String?
  // Una pyme espanola no vive en el correo. El telefono solo se usa para
  // avisar de lo que no puede esperar (una candidatura, una entrega, un pago)
  // y solo si lo ha pedido: whatsappOptIn es el permiso, no una casilla
  // marcada de serie.
  phone         String?
  whatsappOptIn Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand          Brand?
  creator        Creator?
  messages       Message[]
  notifications  Notification[]
  reviewsWritten Review[]       @relation("ReviewAuthor")
  demoRequests   DemoRequest[]
}

model Brand {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  sector         String
  city           String
  province       String?
  website        String?
  logoUrl        String?
  description    String?
  teamSize       String? // 1-5 | 6-20 | 21-50 | 50+
  monthlyBudget  Int? // euros
  vatNumber      String?
  billingAddress String?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())

  campaigns     Campaign[]
  savedCreators SavedCreator[]
  deals         Deal[]
  shopifyShop   ShopifyShop?

  // Su cliente en Stripe, para no pedirle la tarjeta en cada colaboracion.
  stripeCustomerId String?
}

model Creator {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle        String  @unique
  displayName   String
  headline      String?
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  category      String // Fitness | Moda | Gastronomia ...
  subcategories String? // CSV
  city          String
  province      String?
  country       String  @default("Espana")
  languages     String  @default("Espanol") // CSV
  verified      Boolean @default(false)
  featured      Boolean @default(false)
  available     Boolean @default(true)

  // Metricas agregadas: las recalcula services/score.js
  totalFollowers    Int       @default(0)
  engagementRate    Float     @default(0)
  // Publicaciones por semana. Una cuenta que publica una vez al mes tiene
  // menos valor para una campana que otra igual que publica tres veces por
  // semana, por muchos seguidores que tenga.
  postsPerWeek      Float     @default(0)
  // De donde salen las tres cifras de arriba. DECLARED mientras las ponga el
  // creador; CONNECTED en cuanto haya al menos una cuenta conectada, y
  // entonces metricsVerifiedAt dice de cuando son.
  metricsSource     String    @default("DECLARED")
  metricsVerifiedAt DateTime?
  score             Float     @default(0)
  rankPosition      Int       @default(0)
  rankDelta         Int       @default(0) // movimiento respecto a la semana pasada
  responseHours     Int       @default(24)
  completedDeals    Int       @default(0)
  ratingAvg         Float     @default(0)
  ratingCount       Int       @default(0)

  // Audiencia
  audienceCountry   String @default("Espana")
  audienceFemalePct Int    @default(50)
  audienceAgeRange  String @default("25-34")

  // Datos fiscales. Un creador que cobra es un autonomo que tiene que emitir
  // factura, y sin esto tiene que hacerla el por su cuenta y a mano.
  taxId          String? // NIF
  billingAddress String?
  // Retencion de IRPF que aplica en sus facturas. 15% es lo habitual; 7% los
  // tres primeros anios de actividad. 0 si no procede.
  irpfRate       Int     @default(0)

  // Tarifas en euros
  ratePost  Int @default(0)
  rateReel  Int @default(0)
  rateStory Int @default(0)
  rateUgc   Int @default(0)

  createdAt DateTime @default(now())

  socialAccounts SocialAccount[]
  portfolio      PortfolioItem[]
  applications   Application[]
  deals          Deal[]
  savedBy        SavedCreator[]
  reviews        Review[]             @relation("ReviewTarget")
  rankHistory    RankSnapshot[]
  shopifyLinks   ShopifyAttribution[]

  // Su cuenta de Stripe (Express): donde aterriza el dinero cuando la
  // empresa aprueba el trabajo.
  //
  // El alta y la verificacion de identidad las hace Stripe en su propio
  // formulario. Nosotros no vemos ni guardamos un DNI ni un IBAN, y eso no
  // es comodidad: es no querer ser responsables de custodiar esos datos.
  stripeAccountId   String?
  // Lo que Stripe dice que puede hacer esa cuenta, refrescado por webhook.
  // Sin payoutsOk no se le puede transferir nada, y conviene saberlo antes
  // de cerrar un trato y no al intentar pagarle.
  stripeChargesOk   Boolean   @default(false)
  stripePayoutsOk   Boolean   @default(false)
  stripePendiente   String?
  stripeOnboardedAt DateTime?

  // Por donde quiere cobrar.
  //
  //   STRIPE  a su cuenta bancaria. Sale del dinero que ya esta cobrado, asi
  //           que se envia al aprobar el contenido y no espera a nadie.
  //   PAYPAL  a su correo de PayPal. Hace falta para quien no quiere dar su
  //           IBAN, y tiene un coste que no tiene la otra: PayPal se lleva
  //           ~2% y el pago sale en lotes, porque el saldo de PayPal es otro
  //           bolsillo distinto del de Stripe (ver paypal/config.js).
  payoutMethod String  @default("STRIPE") // STRIPE | PAYPAL
  paypalEmail  String?
}

// Una cuenta de red social del creador.
//
// Hay dos formas de que existan estos numeros y no valen lo mismo:
//
//  - DECLARED: los escribio el creador. Sirven para empezar, pero nadie los ha
//    comprobado, y un ranking que ordena por datos que el interesado se pone a
//    si mismo premia a quien exagera.
//  - CONNECTED: el creador conecto la cuenta y los trae la API de la
//    plataforma. Los seguidores son los de verdad y el engagement sale de sus
//    publicaciones reales, no de una media que alguien recuerda.
//
// Por eso source se guarda junto al dato y viaja con el hasta la interfaz: la
// empresa tiene derecho a saber cual de los dos esta mirando.
model SocialAccount {
  id         String  @id @default(cuid())
  creatorId  String
  creator    Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform   String // instagram | tiktok | youtube
  handle     String
  url        String?
  followers  Int     @default(0)
  engagement Float   @default(0)
  avgViews   Int     @default(0)

  source String @default("DECLARED") // DECLARED | CONNECTED

  // De donde salen los datos, que no es lo mismo que si los tenemos.
  //
  //   LOOKUP  el creador nos dio su @ y los leemos nosotros. Es el camino
  //           normal: no le saca de Mikro. En YouTube va por la API oficial;
  //           en Instagram y TikTok, por un servicio de consulta de pago.
  //   OAUTH   el creador autorizo de verdad. Mas friccion, mejor dato, y
  //           prueba por si mismo de que la cuenta es suya.
  metodo String @default("OAUTH") // OAUTH | LOOKUP

  // Cuando se comprobo que la cuenta es de este creador, poniendo un codigo
  // en la biografia. Con OAUTH es implicito. Con LOOKUP hace falta, porque si
  // no cualquiera podria dar de alta el @ de otro y cobrar por su audiencia.
  ownershipVerifiedAt DateTime?

  // Credenciales de la conexion. Los tokens van cifrados (lib/secrets.js): son
  // la llave de la cuenta de otra persona, y una copia de seguridad de la base
  // no deberia ser una lista de accesos a cuentas ajenas.
  externalId   String?
  accessToken  String?
  refreshToken String?
  tokenExpires DateTime?
  scopes       String?
  connectedAt  DateTime?
  lastSyncAt   DateTime?
  syncError    String?

  // Lo que se calcula de las publicaciones traidas, no de lo que diga nadie.
  postsAnalyzed Int       @default(0)
  postsPerWeek  Float     @default(0)
  avgLikes      Int       @default(0)
  avgComments   Int       @default(0)
  lastPostAt    DateTime?

  posts     SocialPost[]
  snapshots SocialSnapshot[]

  @@unique([creatorId, platform])
  @@index([source])
}

// Una publicacion traida de la plataforma.
//
// Se guardan las ultimas para poder calcular el engagement y la frecuencia
// nosotros mismos, y para poder ensenar de donde sale cada cifra. Sin esto el
// engagement seria otro numero opaco que hay que creerse.
model SocialPost {
  id           String        @id @default(cuid())
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId   String
  permalink    String?
  mediaType    String? // IMAGE | VIDEO | CAROUSEL | REEL | SHORT
  caption      String?
  thumbnailUrl String?

  likes    Int  @default(0)
  comments Int  @default(0)
  views    Int  @default(0)
  shares   Int  @default(0)
  saves    Int  @default(0)
  reach    Int?

  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@unique([accountId, externalId])
  @@index([accountId, publishedAt])
}

// Foto de las metricas en un momento dado.
//
// Permite ensenar la evolucion y, sobre todo, detectar saltos imposibles: mil
// seguidores nuevos en un dia sin una publicacion que lo explique es la firma
// de los seguidores comprados.
model SocialSnapshot {
  id           String        @id @default(cuid())
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  followers    Int
  engagement   Float
  postsPerWeek Float         @default(0)
  takenAt      DateTime      @default(now())

  @@index([accountId, takenAt])
}

model PortfolioItem {
  id        String  @id @default(cuid())
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  platform  String?
  likes     Int     @default(0)
  position  Int     @default(0)
}

model RankSnapshot {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  position  Int
  score     Float
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Campanas y colaboraciones
// ---------------------------------------------------------------------------

model Campaign {
  id           String @id @default(cuid())
  brandId      String
  brand        Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title        String
  brief        String
  category     String
  deliverables String // CSV: "1 reel, 3 stories"

  // Que se promociona. Un producto se puede comprar, asi que su venta se
  // puede medir y por tanto se puede pagar por resultado; un servicio, de
  // momento, no. De ahi que solo las campanas de producto ofrezcan variable.
  kind String @default("PRODUCT") // PRODUCT | SERVICE

  // Como se paga al creador:
  //   FIXED          un importe acordado, y ya.
  //   FIXED_VARIABLE un importe acordado mas un porcentaje de lo que venda.
  //   VARIABLE       solo el porcentaje.
  //
  // El variable no es una promesa vacia: se calcula sobre las ventas
  // atribuidas al codigo del creador, que es justo lo que mide la app de
  // Shopify. Por eso exigir tienda conectada no es un requisito tecnico que
  // nos venga bien, es la unica forma de que la cifra exista.
  payModel      String @default("FIXED")
  commissionPct Int    @default(0)
  // % de la venta neta para el creador

  // Descuento que llevara el codigo del creador. Lo decide la campana porque
  // es parte de la oferta comercial, no una preferencia de la tienda: la
  // misma marca puede hacer un 10% en una campana y un 25% en una
  // liquidacion. Cero significa "usa el valor por defecto de la tienda".
  //
  // Ojo a la relacion con commissionPct: el descuento sale del precio de
  // venta, asi que tambien reduce la base sobre la que se paga la comision.
  // Un 30% de descuento con un 20% de comision es mucho mas caro de lo que
  // parece sumando los dos numeros.
  // Que hace el codigo del creador. Un envio gratis convierte mejor que un
  // 5% en carritos pequenos y a la tienda le cuesta menos que un porcentaje
  // sobre el producto, asi que no es una variante menor: es otra palanca.
  discountType String @default("PERCENTAGE") // PERCENTAGE | FREE_SHIPPING
  discountPct  Int    @default(0)

  // Ficha del producto. Solo tiene sentido en campanas de producto, y
  // resuelve algo muy concreto: hoy el creador tiene que adivinar que va a
  // promocionar leyendo el brief. Con la ficha sabe que es, cuanto cuesta y
  // donde esta antes de postularse.
  productName  String?
  productUrl   String? // la pagina del producto en la tienda
  productImage String?
  productSku   String?
  // Si hay algo fisico que mandarle al creador. Separado de productValue
  // porque se puede ceder producto sin enviarlo (una cena, un servicio) y se
  // puede enviar algo que no se cede (una muestra que se devuelve).
  shipsProduct Boolean @default(false)

  budgetMin    Int
  budgetMax    Int
  targetCity   String?
  minFollowers Int       @default(0)
  maxFollowers Int       @default(1000000)
  platforms    String    @default("instagram") // CSV
  status       String    @default("OPEN") // DRAFT | OPEN | CLOSED | COMPLETED
  startDate    DateTime?
  endDate      DateTime?
  productValue Int       @default(0)
  createdAt    DateTime  @default(now())

  applications Application[]
  deals        Deal[]
  shopifyLinks ShopifyAttribution[]
}

model Application {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  message     String?
  proposedFee Int
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  source      String   @default("CREATOR") // CREATOR (se apunta) | BRAND (invitacion)
  createdAt   DateTime @default(now())

  @@unique([campaignId, creatorId])
}

model Deal {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  fee         Int
  feePlatform Int      @default(0) // comision de Mikro

  // Condiciones congeladas al aceptar la candidatura. La campana puede
  // cambiar despues, pero lo pactado con esta persona no: nadie puede ver
  // cambiado a la baja el trato que ya habia cerrado.
  payModel      String @default("FIXED")
  commissionPct Int    @default(0)
  status        String @default("ACCEPTED") // ACCEPTED | FUNDED | IN_PROGRESS | SUBMITTED | APPROVED | PAID | CANCELLED

  // Envio del producto al creador.
  //
  // Tiene dos partes y las dos hacen falta, porque la discusion clasica es
  // "yo lo mande" contra "no me ha llegado". Que cada lado marque la suya
  // deja constancia de quien dijo que y cuando, y evita que el creador
  // aparezca como que no entrega cuando lo que pasa es que no ha recibido
  // nada.
  shipmentStatus  String    @default("NONE") // NONE | PENDING | SENT | RECEIVED
  // La direccion la pone el creador cuando hace falta, y vive en la
  // colaboracion y no en su perfil a proposito: es su casa, y solo tiene que
  // verla la empresa con la que ya ha cerrado un trato que exige un envio.
  shippingName    String?
  shippingAddress String?
  shippingPhone   String?
  carrier         String?
  trackingCode    String?
  shipmentNote    String?
  shippedAt       DateTime?
  receivedAt      DateTime?
  contentUrl      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages     Message[]
  reviews      Review[]
  payments     Payment[]
  shopifyLinks ShopifyAttribution[]
  submissions  ContentSubmission[]
  invoices     Invoice[]

  // El cobro que respalda esta colaboracion.
  stripePaymentIntent String?
  // Agrupa en Stripe el cobro con su transferencia. Es una etiqueta para
  // poder reconciliar: no retiene nada por si misma.
  stripeTransferGroup String?
}

// Una entrega de contenido para que la empresa la revise.
//
// Antes esto era un contentUrl y un cambio de estado, lo que funciona hasta
// que alguien pide un cambio: entonces no hay forma de saber que se pidio, ni
// sobre que version, ni cuando. Y el dinero retenido se libera justo aqui, asi
// que la conversacion sobre si el contenido vale o no es precisamente la que
// hay que dejar por escrito.
model ContentSubmission {
  id      String  @id @default(cuid())
  dealId  String
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  version Int
  url     String
  note    String? // lo que dice el creador al entregar

  status     String    @default("PENDING") // PENDING | CHANGES_REQUESTED | APPROVED
  feedback   String? // lo que contesta la empresa
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([dealId, version])
  @@index([dealId])
}

// Factura de una colaboracion.
//
// Son dos documentos distintos y conviene no confundirlos:
//  - CREATOR_TO_BRAND: la que el creador (autonomo) emite a la empresa por su
//    trabajo. Lleva IVA y, si el creador lo indica, retencion de IRPF.
//  - MIKRO_COMMISSION: la que Mikro emite al creador por su comision.
//
// Los importes van en centimos y como enteros. El resto del modelo usa euros
// enteros porque las tarifas son redondas, pero una factura con IVA no lo es:
// el 21% de 250 son 52,50, y redondear eso es emitir un documento mal.
model Invoice {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind   String // CREATOR_TO_BRAND | MIKRO_COMMISSION

  series String // "C2026" | "M2026"
  number String // numero completo y correlativo: "C2026-0001"

  // Quien emite y quien recibe, congelados en el momento de emitir: si manana
  // el creador cambia de domicilio, la factura de hace un ano no cambia.
  issuerName    String
  issuerTaxId   String?
  issuerAddress String?
  clientName    String
  clientTaxId   String?
  clientAddress String?

  concept    String
  baseCents  Int
  vatRate    Int    @default(21)
  vatCents   Int
  irpfRate   Int    @default(0)
  irpfCents  Int    @default(0)
  totalCents Int

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([number])
  @@index([dealId])
}

model Payment {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount Int
  fee    Int
  kind   String // ESCROW_IN | PAYOUT | REFUND
  status String @default("COMPLETED") // PENDING | COMPLETED | FAILED

  // Hasta ahora estas filas eran la unica realidad: se escribia "ESCROW_IN"
  // y no se movia un euro. Ahora cada una apunta al objeto de Stripe que la
  // respalda. SIMULATED existe para desarrollo y para que la aplicacion
  // funcione sin credenciales, pero la interfaz tiene que decirlo cuando lo
  // use: prometer una garantia que no existe es peor que no tenerla.
  provider       String  @default("SIMULATED") // STRIPE | SIMULATED
  // pi_... un cobro, tr_... una transferencia, re_... una devolucion.
  stripeId       String?
  // Lo que Stripe cobra por el movimiento, EN CENTIMOS. Sale de nuestra
  // comision, no del creador: la empresa paga el precio acordado y el creador
  // recibe su 88% pase lo que pase.
  //
  // En centimos y no en euros porque una comision de 3,40 EUR guardada como
  // entero se convierte en 3, y cuarenta centimos por cobro descuadran las
  // cuentas al cabo de mil cobros. Nulo cuando todavia no se sabe: Stripe
  // tarda un instante en calcularla, y cero significaria "no costo nada".
  stripeFeeCents Int?

  // PayPal. Son campos aparte y no los de Stripe reaprovechados porque no son
  // lo mismo: un lote de PayPal agrupa varios pagos, asi que un pago tiene
  // dos identificadores (el del lote y el suyo dentro del lote) donde uno de
  // Stripe tiene uno. Juntarlos ahorraria dos columnas y costaria no poder
  // contestar "¿en que lote salio esto?", que es la primera pregunta cuando
  // algo no llega.
  paypalBatchId  String?
  paypalItemId   String?
  // El correo al que se envio, copiado aqui a proposito: si el creador lo
  // cambia manana, esta fila tiene que seguir diciendo adonde fue el dinero.
  paypalEmail    String?
  paypalFeeCents Int?

  error     String?
  reference String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Comunicacion y reputacion
// ---------------------------------------------------------------------------

model Message {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator  @relation("ReviewTarget", fields: [creatorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([dealId, authorId])
}

model SavedCreator {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([brandId, creatorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Captacion de empresas
// ---------------------------------------------------------------------------

// Peticion de demo desde la landing.
//
// Quien rellena este formulario todavia no tiene cuenta, asi que los datos de
// contacto viven aqui y no en User. Si algun dia se registra, userId los une.
// consentAt guarda cuando acepto que le escribamos: en Espana eso no es un
// detalle, es el permiso que legitima la llamada.
model DemoRequest {
  id            String    @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String?
  website       String?
  sector        String?
  city          String?
  teamSize      String? // 1-5 | 6-20 | 21-50 | 50+
  monthlyBudget String? // tramo elegido, no una cifra exacta
  goal          String? // que quiere conseguir con la campana
  status        String    @default("NEW") // NEW | CONTACTED | SCHEDULED | WON | LOST
  source        String    @default("LANDING")
  notes         String?
  consentAt     DateTime?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Shopify
// ---------------------------------------------------------------------------

// Una tienda que ha instalado la app de Mikro.
//
// El token de acceso caduca a la hora: Shopify ya no admite tokens offline
// perpetuos para la Admin API en apps publicas nuevas. Por eso se guarda
// tambien el de refresco y la fecha de caducidad, y quien pide el token se
// encarga de renovarlo antes de usarlo.
model ShopifyShop {
  id          String  @id @default(cuid())
  domain      String  @unique // tienda.myshopify.com
  // El dominio publico, que no suele ser el de myshopify. Los enlaces que
  // comparte un creador llevan este: nadie pone un .myshopify.com en su bio.
  publicHost  String?
  name        String?
  email       String?
  currency    String  @default("EUR")
  countryCode String?
  planName    String?

  accessToken  String?
  refreshToken String?
  tokenExpires DateTime?
  scopes       String?

  // Preferencias de la tienda para los codigos que crea. Viven aqui y no en
  // el codigo porque cada marca tiene su convencion, y la nuestra no tiene
  // por que ser la suya.
  codePrefix             String  @default("MIKRO")
  defaultPercentage      Int     @default(10)
  defaultOncePerCustomer Boolean @default(false)

  // La tienda se vincula a una cuenta de empresa de Mikro. Hasta que alguien
  // la reclama desde la app, la instalacion existe pero no tiene dueno.
  brandId String? @unique
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  attributions ShopifyAttribution[]
  orders       ShopifyOrder[]

  @@index([uninstalledAt])
}

// El codigo de descuento que une una colaboracion con las ventas que genera.
//
// Es el metodo de atribucion principal a proposito: un codigo funciona en un
// reel, en una story y de boca en boca, no depende de cookies ni de que el
// seguidor compre en el mismo dispositivo, y el creador puede decirlo en voz
// alta. El enlace con UTM se guarda como apoyo, no como fuente de verdad.
model ShopifyAttribution {
  id     String      @id @default(cuid())
  shopId String
  shop   ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    Creator?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  code         String // MIKRO-MARTA-7F3KQ
  discountGid  String? // el descuento creado en Shopify
  // Un codigo de envio gratis no tiene porcentaje, y ensenar "0%" en el
  // panel seria decir que no descuenta nada cuando si descuenta.
  discountType String    @default("PERCENTAGE") // PERCENTAGE | FREE_SHIPPING
  percentage   Int       @default(10)
  // Destino del enlace que se comparte, guardado como ruta de la tienda
  // ("/products/x"). Ruta y no URL entera: asi el enlace no puede acabar
  // llevando a otro dominio.
  landingUrl   String?
  status       String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  startsAt     DateTime  @default(now())
  endsAt       DateTime?

  // Agregados: evitan recorrer todos los pedidos para pintar un panel.
  // salesTotal es bruto; lo devuelto se guarda aparte para poder enseniar las
  // dos cifras. Restarlo sin mas escondria que hubo una venta y una devolucion.
  ordersCount   Int   @default(0)
  salesTotal    Float @default(0)
  refundedTotal Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders ShopifyOrder[]

  @@unique([shopId, code])
  @@index([campaignId])
  @@index([creatorId])
}

// Un pedido atribuido a una colaboracion.
model ShopifyOrder {
  id     String      @id @default(cuid())
  shopId String
  shop   ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  attributionId String?
  attribution   ShopifyAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)

  orderGid      String
  orderNumber   String?
  totalPrice    Float
  refundedTotal Float    @default(0)
  currency      String   @default("EUR")
  discountCode  String?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  refunds ShopifyRefund[]

  // El mismo pedido puede llegar varias veces: Shopify entrega al menos una vez.
  @@unique([shopId, orderGid])
  @@index([attributionId])
}

// Una devolucion sobre un pedido atribuido.
//
// Existe como tabla propia y no como un campo del pedido porque un pedido
// admite varias devoluciones parciales, y porque hace falta una clave unica
// por devolucion: sin ella, un reintento del webhook restaria dos veces.
model ShopifyRefund {
  id        String       @id @default(cuid())
  shopId    String
  orderId   String
  order     ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundGid String
  amount    Float
  currency  String       @default("EUR")
  createdAt DateTime     @default(now())

  @@unique([shopId, refundGid])
  @@index([orderId])
}

// Registro de webhooks ya procesados.
//
// Shopify garantiza "al menos una vez", no "exactamente una vez". Sin esto,
// un reintento sumaria dos veces la misma venta.
model ShopifyWebhookEvent {
  id         String   @id // X-Shopify-Webhook-Id
  topic      String
  shopDomain String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// Eventos de Stripe ya procesados.
//
// Stripe entrega "al menos una vez", igual que Shopify: sin esta tabla, un
// reintento del aviso de cobro marcaria dos veces la misma colaboracion como
// pagada. Con dinero de por medio eso no es un duplicado cosmetico.
model StripeEvent {
  id        String   @id // el id del evento, tal cual
  type      String
  createdAt DateTime @default(now())

  @@index([type])
}
