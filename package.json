{
  "name": "mikro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketplace que conecta pymes con micro-influencers",
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "dev": "node scripts/dev.js",
    "dev:backend": "nodemon backend/src/server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "start": "node backend/src/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "build:netlify": "npm run db:reset && npm run build",
    "db:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma --accept-data-loss",
    "db:seed": "node backend/prisma/seed.js",
    "db:reset": "npm run db:generate && npm run db:push && npm run db:seed",
    "seed": "npm run db:seed",
    "smoke": "node backend/scripts/smoke.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "serverless-http": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
