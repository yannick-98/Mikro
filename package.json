{
  "name": "mikro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketplace que conecta pymes con micro-influencers",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev -w mikro-backend",
    "dev:frontend": "npm run dev -w mikro-frontend",
    "db:reset": "npm run setup -w mikro-backend",
    "seed": "npm run db:seed -w mikro-backend",
    "smoke": "node backend/scripts/smoke.js",
    "build": "npm run build -w mikro-frontend",
    "build:netlify": "npm run setup -w mikro-backend && npm run build -w mikro-frontend"
  },
  "dependencies": {
    "serverless-http": "^3.2.0"
  }
}
