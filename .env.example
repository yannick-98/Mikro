# En local: `npm run db:local` levanta un Postgres embebido en este puerto.
# En produccion: la cadena del Postgres gestionado (Neon, Supabase, Render...).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
JWT_SECRET="cambia-esto-en-produccion"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
PLATFORM_FEE_PCT=12
