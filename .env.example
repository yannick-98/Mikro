# Postgres. En produccion, la cadena del proveedor gestionado (Supabase, Neon...).
#
# Supabase: Project Settings -> Database -> Connection string
#   - DATABASE_URL      usa el pooler (puerto 6543, "Transaction"): es la que
#                       usa la aplicacion, y evita agotar conexiones.
#   - DIRECT_DATABASE_URL usa la conexion directa (puerto 5432, "Session"):
#                       Prisma la necesita para aplicar migraciones.
DATABASE_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

JWT_SECRET="cambia-esto-en-produccion"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
PLATFORM_FEE_PCT=12

# --- App de Shopify -------------------------------------------------------
# Partner Dashboard -> Apps -> tu app -> Client credentials.
# Sin estas dos, las rutas /api/shopify existen pero responden que la app no
# esta configurada; el resto de Mikro funciona igual.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# URL publica de la app: es a donde Shopify manda los webhooks. En desarrollo,
# el tunel que uses (cloudflared, ngrok). Sin barra final.
SHOPIFY_APP_URL="http://localhost:5173"

# --- Cifrado de credenciales ----------------------------------------------
# Obligatoria para conectar cuentas de redes sociales: los tokens se guardan
# cifrados (AES-256-GCM). Sin ella, conectar falla a proposito en vez de
# guardar llaves de cuentas ajenas en claro.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=""

# --- Redes sociales -------------------------------------------------------
# Cada una se activa por separado. Lo que no este configurado se ensena como
# "todavia no disponible" en vez de dar un boton que lleva a un error.
#
# YouTube es la unica con API oficial y gratis: los datos de un canal son
# publicos y basta una clave nuestra. Google Cloud -> YouTube Data API v3.
YOUTUBE_API_KEY=""

# El servicio que consulta perfiles de Instagram y TikTok por su @. Es lo que
# permite que un creador se de de alta sin pasar por ninguna pantalla de
# permisos, y lo que mas desbloquea por lo que menos cuesta. Apify tiene capa
# gratuita: Settings -> Integrations -> API token.
# Se paga por consulta: ver docs/REDES.md antes de subir la frecuencia.
APIFY_TOKEN=""
# Solo si se usa otro servicio distinto de Apify.
SOCIAL_LOOKUP_PROVIDER=""

# Meta for Developers -> app Business -> Instagram -> API setup with
# Instagram login. Permiso: instagram_business_basic.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# TikTok for Developers -> Login Kit + Display API.
# Permisos: user.info.basic, user.info.stats, video.list.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# A donde vuelve el creador tras autorizar. Por defecto se compone con APP_URL
# y no hace falta tocarlo.
APP_URL="http://localhost:5173"

# --- Avisos por WhatsApp (opcional) ---------------------------------------
# WhatsApp Business Platform (Cloud API). Hace falta una plantilla aprobada
# con dos parametros de texto en el cuerpo: fuera de la ventana de 24 h solo
# se pueden mandar plantillas, y nuestros avisos siempre caen fuera.
# Sin esto, los avisos se quedan dentro de la aplicacion.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE="mikro_aviso"

# --- Datos del emisor de las facturas de comision -------------------------
MIKRO_LEGAL_NAME=""
MIKRO_TAX_ID=""
MIKRO_ADDRESS=""

# --- Cobros con Stripe ----------------------------------------------------
# Cargos y transferencias separados: se cobra a la empresa contra la cuenta
# de Mikro, el dinero se queda ahi, y al aprobar el contenido se transfiere
# al creador. Ese hueco entre las dos llamadas es la garantia de pago.
#
# Aviso importante que conviene no olvidar: esto NO es una cuenta escrow
# segregada. El dinero cobrado vive en el saldo de Stripe de Mikro hasta que
# se transfiere. Se puede decir "esta cobrado y no se le envia hasta que
# apruebes"; no se puede decir que este fuera del alcance de los acreedores
# de Mikro.
#
# Sin estas variables la aplicacion funciona, pero los pagos quedan en modo
# demostracion y la interfaz lo dice en vez de prometer una garantia falsa.
STRIPE_SECRET_KEY=""
# Dashboard -> Desarrolladores -> Webhooks -> endpoint a
# https://TU-DOMINIO/api/stripe/webhooks
# Eventos: checkout.session.completed, payment_intent.payment_failed,
#          account.updated, transfer.reversed
STRIPE_WEBHOOK_SECRET=""

# --- PayPal (opcional) ----------------------------------------------------
# Dos cosas distintas:
#
#   Pagar CON PayPal no se configura aqui: va por Stripe, activando PayPal en
#   sus metodos de pago. Para los cobros de colaboraciones hace falta ademas
#   que Stripe apruebe PayPal junto a Connect.
#
#   Cobrar EN PayPal (el creador) si es esto. Hace falta una cuenta business
#   con Payouts aprobado. Sin estas variables, la opcion no aparece y todo el
#   mundo cobra por el banco.
#
# OJO: estos pagos salen del saldo de PayPal, que no es el de Stripe y hay que
# llenarlo a mano. Ver docs/COBROS.md.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# sandbox | live. Por defecto sandbox, que aqui se mueve dinero.
PAYPAL_MODE="sandbox"
